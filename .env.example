# Template only — never put a real key in this file, it is committed.
# Copy to .env (gitignored) and fill in.

# Groq hosted inference — https://console.groq.com/keys
GROQ_API_KEY=
# 70B measured at 67.4% golden-set accuracy vs 52.2% for llama-3.1-8b-instant,
# and faster (7.6s vs 13.7s median) because it needs no repair round trips.
GROQ_MODEL=llama-3.3-70b-versatile
